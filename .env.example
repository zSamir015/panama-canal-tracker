# Copiar a .env y completar. NUNCA commitear .env

# Entorno: development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Orígenes permitidos para CORS (separados por coma). En producción, solo el dominio del mapa.
CORS_ORIGINS=http://localhost:5173

# Base de datos (Fase 2) — PostgreSQL 16 + PostGIS + TimescaleDB (`docker compose up -d`)
# La app usa un rol SIN permisos de DDL; las migraciones usan el rol propietario (AGENTS.md §8.16).
# Valores de desarrollo local únicamente. En producción, contraseñas largas y aleatorias:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# docker-compose.yml lee las tres contraseñas para crear los roles la PRIMERA vez que arranca la
# base. Si las cambias después, hay que recrear el volumen: `docker compose down -v`.
POSTGRES_PASSWORD=changeme
CANAL_OWNER_PASSWORD=changeme
CANAL_APP_PASSWORD=changeme
# Deben usar las mismas contraseñas que las variables de arriba.
DATABASE_URL=postgresql+asyncpg://canal_app:changeme@localhost:5432/canal_tracker
# Solo para Alembic (rol con DDL). El proceso de la API no la necesita: en producción no se le pasa.
# Los tests de integración usan estas dos URLs cambiando la base por `canal_tracker_test`.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://canal_owner:changeme@localhost:5432/canal_tracker

# Redis — rate limiting (Fase 2) y pub/sub entre worker y API (Fase 3)
REDIS_PASSWORD=changeme
# Debe usar la misma contraseña que REDIS_PASSWORD. La app la usa para el rate limiting (ADR-0007);
# en producción es obligatoria y no puede llevar el placeholder.
REDIS_URL=redis://:changeme@localhost:6379/0

# JWT (Fase 2)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
# La app se niega a arrancar en producción si el secreto es este placeholder o mide < 32 bytes.
JWT_SECRET_KEY=changeme
# Único valor admitido: HS256 (la app no arranca con otro, ni con `none`).
JWT_ALGORITHM=HS256
JWT_ISSUER=panama-canal-tracker
JWT_AUDIENCE=panama-canal-tracker-api
# Límites: access de 1 a 60 minutos; refresh de 1 a 30 días.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AISStream (Fase 3) — registrarse gratis en https://aisstream.io
# Solo la lee el worker; nunca la API ni el frontend. Vacía, el worker no arranca.
AISSTREAM_API_KEY=
# Por defecto, AISStream real (wss://stream.aisstream.io/v0/stream). Para desarrollar sin key:
#   python scripts/ais_simulator.py serve   y   AISSTREAM_URL=ws://127.0.0.1:8765
# AISSTREAM_URL=

# Worker AIS (Fase 3)
AIS_RECONNECT_MAX_SECONDS=60
# Mensajes en espera entre el WebSocket y el writer; si se llena, se descartan los más antiguos.
AIS_QUEUE_MAX_SIZE=10000
# El writer guarda un lote al llegar a AIS_BATCH_SIZE posiciones o cada AIS_BATCH_FLUSH_SECONDS.
AIS_BATCH_SIZE=500
AIS_BATCH_FLUSH_SECONDS=2
# Segunda conexión (ADR-0009): datos estáticos de todo el mundo para los buques con destino al
# Canal. false = solo la conexión del área del Canal.
AIS_CANAL_BOUND_ENABLED=true

# Detección de tránsitos (Fase 5)
TRANSIT_SIGNAL_TIMEOUT_MINUTES=30

# Frontend (web/.env) — Fase 4
# ¡Toda variable VITE_* termina en el JavaScript público! Nunca poner secretos ahí.
# Vacío (lo normal): la API en el mismo origen. En desarrollo, Vite reenvía /api y /ws a :8000.
# VITE_API_URL=
# VITE_MAP_STYLE_URL=   # vacío: OpenFreeMap (ADR-0010)
